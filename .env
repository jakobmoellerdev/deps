# Versions of the tools the Taskfile installs (Taskfile.yml loads this file with `dotenv`), with
# the checksums their installers verify. deps keeps them current: the `custom` entries in
# .deps.yaml move each version together with its checksums in one PR.

# golangci-lint: lint:install verifies the archive against the release's checksums file.
GOLANGCI_LINT_VERSION=2.15.0

# git-cliff: changelog:install (sha512 of git-cliff-<v>-<arch>-unknown-linux-gnu.tar.gz)
GIT_CLIFF_VERSION=2.14.2
GIT_CLIFF_SHA512_LINUX_X86_64=26d1f7c8ea2400f2ccb0b2e7f321635f600b583bf4cd1f7afaa5e8c24068ad1088a2504e0a4d9f4333d4bb20a80329327d9462634343ee3af91e1a7fbdc6f18a
GIT_CLIFF_SHA512_LINUX_AARCH64=fd27768ea76fea8c3ba3f3247fef2f6604988b629f15e48bf40be5eaa08b8fef2e4087cc9c8af16bc522bc19cc369611fa7692101b513f63469ad58522708600

# nfpm: nfpm:install (sha256 of nfpm_<v>_Linux_<arch>.tar.gz)
NFPM_VERSION=2.48.0
NFPM_SHA256_LINUX_X86_64=6d7f9a28b2f397934403950fcbba83f598b08d02edbe79a0815b3b4897341750
NFPM_SHA256_LINUX_ARM64=a9a75213763783b7669719e505474c748c5ad7dc66591a195619deb50f85c2f4

# syft: syft:install (sha256 of syft_<v>_linux_<arch>.tar.gz)
SYFT_VERSION=1.56.0
SYFT_SHA256_LINUX_AMD64=1c2493cfcf52d3367d6cb25780d9190c111c2219c34c820574c43e8bae15c528
SYFT_SHA256_LINUX_ARM64=ace61b9397ae28189c674ae332d67a8074dafd71e87724dfb8b22412d8253bb5

# cosign: cosign:install (sha256 of cosign-linux-<arch>)
COSIGN_VERSION=3.1.4
COSIGN_SHA256_LINUX_AMD64=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
COSIGN_SHA256_LINUX_ARM64=ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2
